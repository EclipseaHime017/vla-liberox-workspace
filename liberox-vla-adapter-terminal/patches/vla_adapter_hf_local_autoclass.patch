+def register_openvla_auto_classes() -> None:
+    """Register the repository's audited OpenVLA classes with Transformers.
+
+    Hub checkpoints advertise these classes through ``auto_map``. Registering
+    the checked-out local implementations lets Transformers resolve
+    ``model_type=openvla`` while keeping ``trust_remote_code=False``.
+    """
