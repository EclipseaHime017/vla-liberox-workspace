# Platform source, configuration and user documentation are versioned.
# Upstream checkouts and generated experiment data stay local.
/third_party/*
!/third_party/.gitkeep
/dataset-root/
/training-datasets/
/runs/
/policy-registry/*
!/policy-registry/.gitkeep
/vla-adapter-rynn-iql/outputs/
/vla-adapter-robometer/outputs/
/models/*
!/models/.gitkeep
/evaluator/*
!/evaluator/.gitkeep
/tmp/
/annotation-cache/

# Local development notes are not distributed with the source repository.
/logs/

# Python
**/__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/
env/
events.out.tfevents.*
wandb/

# Frontend
**/node_modules/
# Vite output stays machine-local; run_ui.py rebuilds it when sources change.
**/frontend/dist/
**/frontend/*.tsbuildinfo
**/frontend/vite.config.js
**/frontend/vite.config.d.ts

# Local configuration and caches
.env
.env.*
!.env.example
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.cache/

# Generated trajectories, videos, and portable dataset exports
/dataset-exports/
*.npy
*.npz
*.mp4
*.avi
*.mkv
*.zip

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large model checkpoints should be downloaded separately.
*.safetensors
*.ckpt
*.pth
*.pt
