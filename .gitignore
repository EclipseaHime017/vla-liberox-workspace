# Source, configuration, environment recipes and documentation are versioned.
# Upstream checkouts, weights and generated data stay local; envs/setup.py
# fetches only what a device role needs (see docs/install.md).
/third_party/*
!/third_party/.gitkeep
!/third_party/README.md
!/third_party/lock*.yaml
!/third_party/factr.lock.json
!/third_party/patches/
/dataset-root/
/dataset-exports/
/training-datasets/
/runs/
/outputs/
/policy-registry/*
!/policy-registry/.gitkeep
/models/*
!/models/.gitkeep
/evaluator/*
!/evaluator/.gitkeep
/tmp/
/annotation-cache/
# Site-specific scheduler settings (queues, projects, accounts).
/configs/cluster/local/

# Local development notes and one-off experiment tooling stay on each machine.
/logs/
/experiments/

# Python
**/__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/
env/
events.out.tfevents.*
wandb/

# Frontend
**/node_modules/
# Vite output stays machine-local; `python -m studio` rebuilds it when sources change.
/web/dist/
/web/*.tsbuildinfo
/web/vite.config.js
/web/vite.config.d.ts

# Local configuration and caches
.env
.env.*
!.env.example
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.cache/

# Generated trajectories, videos, and portable dataset exports
*.npy
*.npz
*.mp4
*.avi
*.mkv
*.zip

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large model checkpoints should be downloaded separately.
*.safetensors
*.ckpt
*.pth
*.pt
